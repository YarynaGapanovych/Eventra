generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

model Area {
  id        String   @id @default(cuid())
  name      String
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id        String   @id @default(cuid())
  name      String?
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  progressStatus ProgressStatus @default(NOT_STARTED)
  scheduled      Boolean        @default(true)
  areaId         String?
  area           Area?          @relation(fields: [areaId], references: [id], onDelete: SetNull)
  employees      Employee[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}
