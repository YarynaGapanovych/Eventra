# Postgres (same DB name as docker/docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calendar"

# Kafka — broker from Docker (KAFKA_ADVERTISED_LISTENERS: PLAINTEXT://localhost:9092)
KAFKA_BROKERS="localhost:9092"
KAFKA_CLIENT_ID="eventra-worker"
KAFKA_GROUP_ID="eventra-worker"
KAFKA_TASKS_TOPIC="eventra.tasks.v1"

# Optional: Nest HTTP port if you add a health controller
# PORT=3001
