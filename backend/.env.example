# Docker Postgres (see docker/docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calendar"
#
# Local Homebrew Postgres: no "postgres" user — use your macOS username:
DATABASE_URL="postgresql://YOUR_MACOS_USERNAME@localhost:5432/calendar"

PORT=3001

# Used to sign auth tokens (use a long random value in production).
JWT_SECRET="replace-with-long-random-string-in-production"

# Google Calendar sync (OAuth 2.0)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALENDAR_REDIRECT_URI below.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3001/integrations/google-calendar/callback"

