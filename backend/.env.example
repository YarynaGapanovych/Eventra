# Docker Postgres (see docker/docker-compose.yml):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calendar"
#
# Local Homebrew Postgres: no "postgres" user — use your macOS username:
DATABASE_URL="postgresql://YOUR_MACOS_USERNAME@localhost:5432/calendar"

PORT=3001

# Used to sign auth tokens (use a long random value in production).
JWT_SECRET="replace-with-long-random-string-in-production"

# Google OAuth (sign-in + Calendar sync)
# Create credentials: https://console.cloud.google.com/apis/credentials
# Enable the Google Calendar API for the same project:
#   https://console.developers.google.com/apis/api/calendar-json.googleapis.com/overview
# Add both authorized redirect URIs in Google Cloud Console:
#   - GOOGLE_AUTH_REDIRECT_URI (Google sign-in)
#   - GOOGLE_CALENDAR_REDIRECT_URI (Calendar sync)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_AUTH_REDIRECT_URI="http://localhost:3001/auth/google/callback"
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3001/integrations/google-calendar/callback"

# Encrypt Google refresh tokens at rest (32+ random chars; falls back to JWT_SECRET if unset).
GOOGLE_TOKEN_ENCRYPTION_KEY="replace-with-long-random-string-in-production"

