generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}

enum TaskBoardStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum TaskSource {
  eventra
  google
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  googleCalendarIntegration GoogleCalendarIntegration?
  tasks                     Task[]
}

model GoogleCalendarIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  updatedAt             DateTime  @updatedAt
}

model Task {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  startDate      DateTime
  endDate        DateTime
  progressStatus String           @default("not_started")
  status         TaskBoardStatus  @default(todo)
  priority       TaskPriority     @default(medium)
  deadline       DateTime?
  scheduled      Boolean          @default(false)
  areaId         String?
  googleEventId  String?
  source         TaskSource       @default(eventra)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleEventId])
  @@index([userId])
}
