generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TaskBoardStatus {
  todo
  in_progress
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum EventSource {
  eventra
  google
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  googleCalendarIntegration GoogleCalendarIntegration?
  userSettings              UserSettings?
  tasks                     Task[]
  events                    Event[]
}

model UserSettings {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  user                        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workdayStart                String   @default("09:00")
  workdayEnd                  String   @default("17:00")
  timezone                    String   @default("UTC")
  defaultEventDurationMinutes Int      @default(60)
  showPastDoneTaskEvents      Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model GoogleCalendarIntegration {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenEncrypted String
  accessTokenEncrypted  String?
  accessTokenExpiresAt  DateTime?
  connectedAt           DateTime  @default(now())
  lastSyncedAt          DateTime?
  syncDaysBack          Int       @default(30)
  syncDaysForward       Int       @default(90)
  updatedAt             DateTime  @updatedAt
}

model Task {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  progressStatus String          @default("not_started")
  status         TaskBoardStatus @default(todo)
  priority       TaskPriority    @default(medium)
  deadline       DateTime?
  areaId         String?
  events         Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Event {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  start         DateTime
  end           DateTime
  source        EventSource @default(eventra)
  googleEventId String?
  taskId        String?
  task          Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, googleEventId])
  @@index([userId, start])
  @@index([taskId])
}
